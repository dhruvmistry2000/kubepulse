# Copy to .env and change the keys. .env is not committed.
# The process refuses to start without ADMIN_KEY.

ADMIN_KEY=change-me-to-admin-key
VIEWER_KEY=change-me-to-viewer-key

# Legacy heartbeat key for clusters registered before per-cluster credentials. Leave empty if you have none.
SECRET_KEY=

# URL the agent puts in the generated helm command. Pods cannot use 127.0.0.1.
# On a VM this is the public https URL. On the local kind cluster it is the host
# address as seen from a pod, for example http://172.19.0.1:8080
DASHBOARD_URL=https://dashboard.example.com

# Host port published to container port 8080.
DASHBOARD_PORT=8080

# Chart repo published by the Helm release workflow to GitHub Pages.
HELM_REPO_URL=https://dhruvmistry2000.github.io/kubepulse

# Add Cluster fills these into the helm command. Defaults match the published chart.
# HELM_CHART_NAME=k8s-dashboard-agent
# AGENT_IMAGE=dhruvmistry200/kubepulse-agent:latest
