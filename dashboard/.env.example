# Leave blank to auto-generate on first start; then copy from logs and set to persist across restarts
SECRET_KEY=

# Leave blank to use SECRET_KEY for admin actions (e.g. generating registration tokens)
ADMIN_KEY=

# Your public dashboard URL; used in generated helm commands in Add Cluster tab
DASHBOARD_URL=

# Persistent cluster registry backend: file (default) or gcs (required for Cloud Run)
STORAGE_BACKEND=file
STORAGE_PATH=/data/kubepulse/registry.json

# GCS backend (Cloud Run): set STORAGE_BACKEND=gcs and configure bucket/object
GCS_BUCKET=
GCS_OBJECT=kubepulse/registry.json

# Node history (scaling + retired nodes)
HISTORY_PATH=/data/kubepulse/history.json
GCS_HISTORY_OBJECT=kubepulse/history.json
HISTORY_RETENTION_DAYS=30

PORT=8080
